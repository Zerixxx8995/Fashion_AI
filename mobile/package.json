{
  "name": "fashion-ai-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest --passWithNoTests",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@clerk/clerk-expo": "^2.7.2",
    "expo": "~53.0.0",
    "expo-router": "~4.0.0",
    "expo-secure-store": "^57.0.1",
    "react": "18.3.1",
    "react-native": "0.76.7",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~18.3.0",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.12",
    "typescript": "~5.3.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@clerk/clerk-expo$": "<rootDir>/__mocks__/@clerk/clerk-expo.ts"
    },
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": {
            "jsx": "react",
            "module": "commonjs",
            "moduleResolution": "node",
            "esModuleInterop": true,
            "skipLibCheck": true,
            "strict": false
          },
          "diagnostics": false
        }
      ]
    }
  }
}
