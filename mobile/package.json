{
  "name": "fashion-ai-mobile",
  "version": "1.0.0",
  "main": "index.js",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest --passWithNoTests",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@clerk/clerk-expo": "^2.7.2",
    "expo": "^54.0.0",
    "expo-auth-session": "^57.0.6",
    "expo-constants": "^57.0.9",
    "expo-linking": "^57.0.5",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-web-browser": "^57.0.2",
    "react": "19.1.0",
    "react-dom": "^19.2.8",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "^5.8.1",
    "react-native-screens": "^4.26.2",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/plugin-transform-class-properties": "^7.29.7",
    "@babel/plugin-transform-private-methods": "^7.29.7",
    "@babel/plugin-transform-private-property-in-object": "^7.29.7",
    "@types/jest": "^29.5.14",
    "@types/react": "~18.3.0",
    "babel-jest": "^29.7.0",
    "babel-preset-expo": "^57.0.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@clerk/clerk-expo$": "<rootDir>/__mocks__/@clerk/clerk-expo.ts"
    },
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": {
            "jsx": "react",
            "module": "commonjs",
            "moduleResolution": "node",
            "esModuleInterop": true,
            "skipLibCheck": true,
            "strict": false
          },
          "diagnostics": false
        }
      ]
    }
  }
}
