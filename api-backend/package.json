{
  "name": "fashion-ai-api-backend",
  "version": "1.0.0",
  "description": "Node.js/Express API backend for Fashion AI",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "test": "jest --runInBand --forceExit",
    "test:models": "jest tests/models --runInBand --forceExit",
    "test:validators": "jest tests/validators.test.js --runInBand --forceExit"
  },
  "jest": {
    "testMatch": [
      "**/tests/models/**/*.test.js",
      "**/tests/validators.test.js",
      "**/tests/auth.test.js",
      "**/tests/alerts.test.js",
      "**/tests/wardrobe.test.js"
    ]
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg": "^8.13.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.5",
    "socket.io": "^4.8.3",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "express-rate-limit": "^8.6.1",
    "express-validator": "^7.3.2",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "sequelize-mock": "^0.10.2",
    "sqlite3": "^5.1.7",
    "supertest": "^7.2.2"
  }
}
