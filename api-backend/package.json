{
  "name": "fashion-ai-api-backend",
  "version": "1.0.0",
  "description": "Node.js/Express API backend for Fashion AI",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "test": "jest --runInBand --forceExit",
    "test:models": "jest tests/models --runInBand --forceExit"
  },
  "jest": {
    "testMatch": ["**/tests/models/**/*.test.js"]
  },
  "dependencies": {
    "sequelize": "^6.37.5",
    "pg": "^8.13.3",
    "pg-hstore": "^2.3.4",
    "express": "^4.21.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "sequelize-mock": "^0.10.2",
    "sqlite3": "^5.1.7",
    "nodemon": "^3.1.9"
  }
}
